# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
next-env.d.ts
/dist/
/.wrangler/
# Checkout-local execution profile and tool state; never publish them.
/.sites-runtime/
/.agents/
/.codex/
/outputs/
/work/
/cloudflare/*/work/
!.env.example
*.tsbuildinfo

# local SQLite for the Node/Vercel runtime
/.data/

# Heavy and scratch media from AI generation passes. Keep the compressed web
# copies in Git; never the multi-megabyte masters or one-off QA frames.
/vibe_videos/
/vibe_images/
/docs/video-assets/frames/
/docs/video-assets/*.mp4
!/docs/video-assets/momo-film-05-make-a-wish-30s-web.mp4
# Superseded sheet carrying a swoosh-like mark; do not publish it.
/docs/video-assets/sameer-character-sheet.png
