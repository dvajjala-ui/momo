ADMIN_EMAILS=
CONTACT_EMAIL=
# Vercel/Next server settings. Never use a NEXT_PUBLIC_ prefix for credentials.
HOST_PASSCODE=
# Optional host login name; defaults to momo. The passcode stays server-side.
ADMIN_USERNAME=momo
# Preferred shared database: Cloudflare D1. Apply migrations with the explicit CLI first.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_D1_DATABASE_ID=
CLOUDFLARE_D1_API_TOKEN=
# Private R2 bucket. Object Read & Write credentials scoped to only this bucket.
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Alternative database (leave unset when using D1).
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Local development only; defaults to .data/momo.sqlite.
MOMO_SQLITE_PATH=
# All WhatsApp values must be configured as runtime settings. Tokens/secrets stay server-side.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_VERSION=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
# Set true only after Meta can reach and verify the signed webhook.
WHATSAPP_WEBHOOK_PUBLIC=false
# Remains false until phone ownership validation exists or hosts have verified recipients.
WHATSAPP_PHONE_VERIFICATION_READY=false

# Public WhatsApp business sender number, distinct from the Meta sender ID.
# Configure only after its signed inbound callback is verified.
WHATSAPP_VERIFICATION_NUMBER=

# Email letters: authorize the dedicated Gmail mailbox privately before setting true.
EMAIL_PROVIDER=gmail
GMAIL_SENDER=the.world.is.waiting.for.uu@gmail.com
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
# Send-only Gmail OAuth plus openid/email to check the exact sender identity.
GMAIL_REFRESH_TOKEN=
# Optional future domain-based sender; select EMAIL_PROVIDER=resend to use it.
RESEND_API_KEY=
EMAIL_FROM=
# Canonical public HTTPS origin, e.g. https://momo-ten-pied.vercel.app (no path/query).
EMAIL_PUBLIC_URL=
EMAIL_SENDING_ENABLED=false
